package core

import "core:fmt"

MAX_NAME_LEN :: 24

Species_Category :: enum u8 {
	Simple,
	Intermediate,
	Advanced,
}

SPECIES_CATEGORY_NAMES := [Species_Category]string {
	.Simple       = "Simple",
	.Intermediate = "Intermediate",
	.Advanced     = "Advanced",
}

Species :: enum u8 {
	// simple
	Minotaur = 0,
	Mountain_Dwarf,
	Merfolk,
	Gargoyle,
	Draconian,
	Troll,
	Deep_Elf,
	Armataur,
	Gnoll,
	// intermediate
	Human,
	Kobold,
	Demonspawn,
	Djinni,
	Spriggan,
	Tengu,
	Oni,
	Barachi,
	Coglin,
	Vine_Stalker,
	// advanced
	Naga,
	Vampire,
	Demigod,
	Formicid,
	Mummy,
	Ghoul,
	Octopode,
	Felid,
}

SPECIES_COUNT :: len(Species)

Species_Def :: struct {
	kind:       Species,
	name:       string,
	abbrev:     string,
	category:   Species_Category,
	base_str:   int,
	base_int:   int,
	base_dex:   int,
	hp_mod_pct: int, // percentage modifier applied to base hp
	mp_mod:     int, // flat modifier to base mp
	innate_att: int,
	innate_def: int,
	trait_desc: string,
	desc:       string,
}

