Background_Category :: enum u8 {
	Warrior,
	Zealot,
	Warrior_Mage,
	Mage,
	Adventurer,
}

BACKGROUND_CATEGORY_NAMES := [Background_Category]string {
	.Warrior      = "Warrior",
	.Zealot       = "Zealot",
	.Warrior_Mage = "Warrior-mage",
	.Mage         = "Mage",
	.Adventurer   = "Adventurer",
}

Background :: enum u8 {
	// warrior
	Fighter = 0,
	Gladiator,
	Monk,
	Hunter,
	Brigand,
	// zealot
	Berserker,
	Chaos_Knight,
	Abyssal_Knight,
	Cinder_Acolyte,
	// warrior-mage
	Reaver,
	Enchanter,
	Shapeshifter,
	Arcane_Marksman,
	Warper,
	// mage
	Hedge_Wizard,
	Conjurer,
	Summoner,
	Necromancer,
	Fire_Elementalist,
	Ice_Elementalist,
	Air_Elementalist,
	Earth_Elementalist,
	Alchemist,
	// adventurer
	Artificer,
	Delver,
	Wanderer,
}

BACKGROUND_COUNT :: len(Background)

Background_Def :: struct {
	kind:         Background,
	name:         string,
	abbrev:       string,
	category:     Background_Category,
	str_mod:      int,
	int_mod:      int,
	dex_mod:      int,
	starting_eq:  [4]Item_Kind,
	starting_bag: [4]Item_Kind,
	spells:       [3]Spell_Kind,
	desc:         string,
}

