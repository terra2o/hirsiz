Character_Config :: struct {
	name:       [MAX_NAME_LEN]u8,
	name_len:   u8,
	species:    Species,
	background: Background,
	seed:       u64,
}

RANDOM_NAMES := [?]string {
	"Aldric",
	"Beren",
	"Caldazar",
	"Durnik",
	"Elowen",
	"Faelar",
	"Grimjaw",
	"Hakon",
	"Iskender",
	"Jorund",
	"Kaelen",
	"Luthien",
	"Morvath",
	"Nym",
	"Ozocubu",
	"Pikel",
	"Quoril",
	"Ragnar",
	"Sif",
	"Tharok",
	"Ulfgar",
	"Vaelin",
	"Wulfric",
	"Xomling",
	"Ymir",
	"Zokar",
}

default_character_config :: proc() -> Character_Config {
	cfg: Character_Config
	set_character_name(&cfg, "Adventurer")
	cfg.species = .Minotaur
	cfg.background = .Berserker
	cfg.seed = 0
	return cfg
}

set_character_name :: proc(cfg: ^Character_Config, name: string) {
	cfg.name = {}
	n := min(len(name), MAX_NAME_LEN - 1)
	for i in 0 ..< n {
		cfg.name[i] = name[i]
	}
	cfg.name_len = u8(n)
}

pick_random_name :: proc() -> string {
	idx := int(generate_random_seed() % u64(len(RANDOM_NAMES)))
	return RANDOM_NAMES[idx]
}

character_name_str :: proc(name: ^[MAX_NAME_LEN]u8, name_len: u8) -> string {
	n := min(int(name_len), MAX_NAME_LEN)
	if n <= 0 do return "Unnamed"
	return string(name[:n])
}

character_combo_abbrev :: proc(sp: Species, bg: Background) -> string {
	return fmt.tprintf("%s%s", SPECIES_DEFS[sp].abbrev, BACKGROUND_DEFS[bg].abbrev)
}

character_full_title :: proc(name: string, sp: Species, bg: Background) -> string {
	sp_def := SPECIES_DEFS[sp]
	bg_def := BACKGROUND_DEFS[bg]
	return fmt.tprintf(
		"%s the %s %s (%s%s)",
		name,
		sp_def.name,
		bg_def.name,
		sp_def.abbrev,
		bg_def.abbrev,
	)
}

compute_starting_stats :: proc(
	sp: Species,
	bg: Background,
) -> (
	str: int,
	intel: int,
	dex: int,
	max_hp: int,
	max_mp: int,
) {
	sp_def := SPECIES_DEFS[sp]
	bg_def := BACKGROUND_DEFS[bg]

	str = max(1, sp_def.base_str + bg_def.str_mod)
	intel = max(1, sp_def.base_int + bg_def.int_mod)
	dex = max(1, sp_def.base_dex + bg_def.dex_mod)

	base_hp := 16 + str / 2
	max_hp = max(8, (base_hp * (100 + sp_def.hp_mod_pct)) / 100)

	if sp == .Djinni {
		max_mp = 0
	} else {
		max_mp = max(0, 2 + intel / 2 + sp_def.mp_mod)
	}
	return
}
